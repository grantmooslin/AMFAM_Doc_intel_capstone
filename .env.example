# Copy this file to .env and add your actual API keys / IDs.
# DO NOT commit .env to version control.
#
# This is the single source of truth for the AMFAM Braintrust environment
# (org, project, datasets, Qwen experiments, model). src/braintrust_config.py
# reads these values, preferring a checked-in braintrust.env when present and
# falling back to .env. Keep the two in sync.

# ---------------------------------------------------------------------------
# API keys (required)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=your-openrouter-api-key-here
BRAINTRUST_API_KEY=your-braintrust-api-key-here

# Optional: separate OpenRouter key (research funding) reserved for LARGE or
# significant runs only (e.g. a final 800-image slice on the most-confident,
# fully-vetted prompt). Used ONLY when a script explicitly invokes it (e.g.
# run_v11_8_800_after_480.py) or as automatic 403-quota failover.
# OPENROUTER_API_KEY remains the default for all routine testing/iteration.
# RESEARCH_FUNDING_API_KEY=your-research-funding-openrouter-key-here

# Optional: separate read-only key for a source account when the dataset lives
# in a different org. Leave blank to use BRAINTRUST_API_KEY.
# DATA_BRAINTRUST_KEY=

# Optional keys for copy_datasets_to_new_env.py (porting datasets from the
# previous account): BRAINTRUST_SOURCE_API_KEY is the old account's key,
# BRAINTRUST_DEST_API_KEY is the new account's key. Both can instead be passed
# via --source-api-key / --dest-api-key.
# BRAINTRUST_SOURCE_API_KEY=
# BRAINTRUST_DEST_API_KEY=

# ---------------------------------------------------------------------------
# Braintrust environment (required for experiments/reports/datasets)
# ---------------------------------------------------------------------------

# Braintrust organization this environment runs experiments in.
BRAINTRUST_ORG_ID=your-org-id-here

# Project used for experiments, reports, and datasets.
BRAINTRUST_PROJECT_NAME=AMFAM v2
BRAINTRUST_PROJECT_ID=your-project-id-here

# Project + dataset that holds the labeled source images (attachments + ground
# truth) that experiments classify. Usually the same project as above.
BRAINTRUST_DATASET_PROJECT=AMFAM v2
BRAINTRUST_DATASET=fixed_size_sampled

# Dataset built from every qwen v1-v11 misclassification, with each row
# annotated by the prompt version it stemmed from.
BRAINTRUST_SMOKE_DATASET=qwen_misclassification_smoke_v1_v11

# Space-separated list of Qwen experiments (prompt versions v1-v11) whose
# misclassifications feed the smoke-test dataset. Entries may carry the suffix
# Braintrust appends to duplicate experiment names. Experiments with zero
# misclassifications contribute no rows.
QWEN_EXPERIMENTS=\
qwen3.7-flash_v1_reasoning-5718f5da \
qwen3.7-flash_v2_reasoning \
qwen3.7-flash_v3_reasoning-14553e3a \
qwen3.7-flash_v4_reasoning \
qwen3.7-flash_v5_reasoning \
qwen3.7-flash_v6_reasoning \
qwen3.7-flash_v7_reasoning \
qwen3.7-flash_v8_reasoning \
qwen3.7-flash_v8.5_reasoning \
qwen3.7-flash_v9_reasoning \
qwen3.7-flash_v10_smoke \
qwen3.7-flash_v10_reasoning \
qwen3.7-flash_v11_smoke \
qwen3.7-flash_v11_reasoning

# Default model used to run experiments against the datasets.
BRAINTRUST_MODEL=qwen/qwen3.7-flash

# API base (only change if you use a Braintrust proxy).
BRAINTRUST_API_BASE=https://api.braintrust.dev
